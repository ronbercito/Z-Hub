import React, { useEffect, useMemo, useState } from "react";
import axios from "axios";
import { CheckCircle2, Eye, RefreshCw, Send, ShieldAlert } from "lucide-react";
import { toast } from "sonner";
import { useAuth } from "../../context/AuthContext";

const KINDS = [
  { key: "reminder", label: "Recordatorio de pago" },
  { key: "cut", label: "Aviso de corte" },
  { key: "payment", label: "Confirmación de pago" },
];

export default function WhatsAppAutomatizadoVIPAutomationTests({ gatewayEnabled, automation }) {
  const { API, token } = useAuth();
  const headers = useMemo(() => ({ Authorization: `Bearer ${token}` }), [token]);
  const [kind, setKind] = useState("reminder");
  const [items, setItems] = useState([]);
  const [selectedId, setSelectedId] = useState("");
  const [preview, setPreview] = useState(null);
  const [loading, setLoading] = useState(false);
  const [sending, setSending] = useState(false);

  const loadCandidates = async () => {
    setLoading(true);
    setPreview(null);
    try {
      const res = await axios.get(`${API}/whatsapp/automatizadovip/automation-test/candidates`, { params: { kind, limit: 50 }, headers });
      const next = res.data?.items || [];
      setItems(next);
      setSelectedId(next[0]?.invoice_id || "");
    } catch (e) {
      setItems([]); setSelectedId("");
      toast.error(e?.response?.data?.detail || "No se pudieron cargar las facturas para la prueba");
    } finally { setLoading(false); }
  };

  useEffect(() => { loadCandidates(); }, [API, token, kind]);
  const selected = items.find(item => item.invoice_id === selectedId);

  const showPreview = async () => {
    if (!selectedId) return toast.error("Seleccione una factura real");
    try {
      const res = await axios.post(`${API}/whatsapp/automatizadovip/automation-test/preview`, { kind, invoice_id: selectedId }, { headers });
      setPreview(res.data);
    } catch (e) { toast.error(e?.response?.data?.detail || "No se pudo preparar la vista previa"); }
  };

  const send = async () => {
    if (!selectedId) return toast.error("Seleccione una factura real");
    if (!gatewayEnabled || !automationEnabled) return toast.error("Active y guarde la pasarela y la automatización seleccionada");
    if (!window.confirm(`Se enviará un WhatsApp REAL a ${preview?.client?.name || selected.client_name}. ¿Continuar?`)) return;
    setSending(true);
    try {
      const res = await axios.post(`${API}/whatsapp/automatizadovip/automation-test/send`, { kind, invoice_id: selectedId, force_test: true }, { headers });
      toast.success(`WhatsApp enviado a ${res.data.client_name} (HTTP ${res.data.status_code})`);
      await showPreview();
    } catch (e) { toast.error(e?.response?.data?.detail || "No se pudo enviar la prueba"); }
    finally { setSending(false); }
  };

  const enabledKey = { reminder: "reminder_enabled", cut: "cut_warning_enabled", payment: "payment_confirmation_enabled" }[kind];
  const automationEnabled = Boolean(automation?.enabled && automation?.[enabledKey]);

  return (
    <div className="p-4 rounded-xl border border-amber-500/20 bg-amber-950/10 space-y-4">
      <div className="flex items-start justify-between gap-3"><div><h4 className="text-xs font-bold text-slate-200">Prueba de automatizaciones con facturas reales</h4><p className="text-[11px] text-slate-500 mt-1">Comprueba la condición, calcula los días y muestra el mismo mensaje que utilizará el worker antes de enviar.</p></div><ShieldAlert className="w-4 h-4 text-amber-400 shrink-0" /></div>
      <div className="flex flex-wrap gap-2">{KINDS.map(item => <button key={item.key} type="button" onClick={() => setKind(item.key)} className={`px-3 py-2 rounded-lg text-[11px] font-bold border ${kind === item.key ? "border-emerald-500/50 bg-emerald-500/10 text-emerald-300" : "border-slate-700 bg-slate-900 text-slate-400"}`}>{item.label}</button>)}</div>
      <div className="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 items-end"><div><label className="block text-xs font-semibold text-slate-300 mb-1">Factura real</label><select value={selectedId} onChange={e => { setSelectedId(e.target.value); setPreview(null); }} className="w-full p-2.5 rounded-lg bg-slate-900 border border-slate-700 text-xs text-slate-100"><option value="">Seleccione una factura</option>{items.map(item => <option key={item.invoice_id} value={item.invoice_id}>{item.invoice_number} · {item.client_name} · S/. {Number(item.amount || 0).toFixed(2)} · {item.due_date || item.payment_date || "sin fecha"}</option>)}</select></div><button type="button" onClick={loadCandidates} disabled={loading} className="px-3 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-50 text-slate-100 text-xs font-bold flex items-center gap-2"><RefreshCw className={`w-4 h-4 ${loading ? "animate-spin" : ""}`} />Actualizar</button></div>
      {selected && <div className="grid grid-cols-2 md:grid-cols-5 gap-2 text-[11px]"><div className="p-2 rounded-lg bg-slate-900/70"><span className="text-slate-500">Cliente</span><div className="text-slate-200 font-semibold truncate">{selected.client_name}</div></div><div className="p-2 rounded-lg bg-slate-900/70"><span className="text-slate-500">Vencimiento</span><div className="text-slate-200 font-semibold">{selected.due_date || "—"}</div></div><div className="p-2 rounded-lg bg-slate-900/70"><span className="text-slate-500">Días restantes</span><div className="text-slate-200 font-semibold">{selected.days_remaining ?? "—"}</div></div><div className="p-2 rounded-lg bg-slate-900/70"><span className="text-slate-500">Estado</span><div className="text-slate-200 font-semibold">{selected.status}</div></div><div className="p-2 rounded-lg bg-slate-900/70"><span className="text-slate-500">Condición</span><div className={selected.eligible ? "text-emerald-300 font-semibold" : "text-amber-300 font-semibold"}>{selected.eligible ? "Cumple" : "No cumple"}</div></div></div>}
      {selected && <p className="text-[11px] text-slate-400">{selected.reason}</p>}
      <div className="flex flex-wrap gap-2"><button type="button" onClick={showPreview} disabled={!selectedId || loading} className="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-50 text-slate-100 text-xs font-bold flex items-center gap-2"><Eye className="w-4 h-4" />Ver mensaje real</button><button type="button" onClick={send} disabled={!selectedId || sending || !gatewayEnabled || !automationEnabled} className="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white text-xs font-bold flex items-center gap-2"><Send className="w-4 h-4" />{sending ? "Enviando..." : "Enviar prueba real"}</button></div>
      {!gatewayEnabled && <p className="text-[10px] text-amber-300">Active y guarde la pasarela antes de enviar una prueba real.</p>}
      {gatewayEnabled && !automationEnabled && <p className="text-[10px] text-amber-300">Active y guarde la automatización seleccionada antes de enviar su prueba.</p>}
      {preview && <div className="p-3 rounded-lg border border-slate-700 bg-slate-950/70 space-y-2"><div className="flex items-center justify-between gap-2"><span className="text-xs font-bold text-slate-200">Vista previa</span><span className={preview.eligible ? "text-emerald-300 text-[11px] font-bold flex items-center gap-1" : "text-amber-300 text-[11px] font-bold"}>{preview.eligible && <CheckCircle2 className="w-3.5 h-3.5" />}{preview.reason}</span></div><div className="text-[11px] text-slate-500">Cliente: <span className="text-slate-300">{preview.client.name}</span> · Número: <span className="text-slate-300">{preview.client.phone}</span> · Hoy: <span className="text-slate-300">{preview.today}</span></div><pre className="whitespace-pre-wrap text-xs leading-5 text-slate-200 p-3 rounded-lg bg-slate-900 border border-slate-800">{preview.message}</pre></div>}
    </div>
  );
}
