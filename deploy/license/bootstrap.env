# Configuración pública de arranque para instalaciones limpias de Z-Hub.
# Los valores pueden sobrescribirse exportando ZHUB_LICENSE_SERVER_URL y/o
# ZHUB_LICENSE_SERVER_PUBLIC_KEY_FILE antes de ejecutar install.sh.
ZHUB_LICENSE_SERVER_DEFAULT_URL=https://192.168.10.240
ZHUB_LICENSE_SERVER_DEFAULT_PUBLIC_KEY_FILE=/etc/zhub/licencia/server-public.pem
