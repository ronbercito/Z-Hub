DATABASE_URL="mysql+aiomysql://${DB_USER}:${DB_PASS}@127.0.0.1:3306/${DB_NAME}"
JWT_SECRET="${JWT_SECRET}"
APP_ENCRYPTION_KEY="${APP_ENCRYPTION_KEY}"
APP_TIMEZONE="America/Lima"
SESSION_COOKIE_SECURE="false"
CORS_ORIGINS="*"
MIKROTIK_TIMEOUT="6"
MIKROTIK_CUT_LIST="morosos"
ZHUB_LICENSE_FILE="/etc/zhub/licencia/licencias.txt"

# Etapa 6/7 — License Server remoto. Dejar URL vacía mantiene modo transición local.
ZHUB_LICENSE_SERVER_URL=""
ZHUB_LICENSE_SERVER_PUBLIC_KEY_FILE="/etc/zhub/licencia/server-public.pem"
ZHUB_LICENSE_CACHE_FILE="/var/lib/zhub/license/authorization.jwt"
ZHUB_LICENSE_SERVER_TIMEOUT="5"
ZHUB_LICENSE_SERVER_ISSUER="zhub-license-server"
ZHUB_LICENSE_SERVER_AUDIENCE="zhub-installation"
