[Unit]
Description=Z-Hub License Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhub-license
Group=zhub-license
WorkingDirectory=/opt/zhub-license-server
EnvironmentFile=/etc/zhub-license-server/server.env
ExecStart=/opt/zhub-license-server/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 2
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zhub-license-server

[Install]
WantedBy=multi-user.target
